# Supabase — client-side (NEXT_PUBLIC_ = exposé au browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase — MCP & CLI
SUPABASE_ACCESS_TOKEN=your-access-token
SUPABASE_PROJECT_REF=your-project-ref

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Connect OAuth (requis pour multi-tenant)
STRIPE_CONNECT_CLIENT_ID=ca_xxx
STRIPE_OAUTH_REDIRECT_URI=https://your-project.supabase.co/functions/v1/integration-oauth/stripe/callback

# HubSpot OAuth (requis pour multi-tenant)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_OAUTH_REDIRECT_URI=https://your-project.supabase.co/functions/v1/integration-oauth/hubspot/callback

# HubSpot (optionnel — legacy, remplace par OAuth ci-dessus)
HUBSPOT_API_KEY=

# Resend (optionnel — log-only si absent)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Monitoring (optionnel)
SLACK_WEBHOOK_URL=

# URL du frontend (utilisé pour générer des liens dans les alertes Slack)
FRONTEND_URL=https://app.sentio.ai
